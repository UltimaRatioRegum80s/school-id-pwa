{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:qr-codes": "node --import tsx/esm src/migrate-qr-codes.ts",
    "migrate:behavior-categories": "node --import tsx/esm src/migrate-behavior-categories.ts",
    "migrate:recognition-tiers": "node --import tsx/esm src/migrate-recognition-tiers.ts",
    "apply:pss-categories": "node --import tsx/esm src/apply-pss-categories.ts",
    "migrate:pin": "node --import tsx/esm src/migrate-to-pin.ts",
    "seed:pss-staff": "node --import tsx/esm src/seed-pss-staff.ts",
    "seed": "node --import tsx/esm src/seed.ts",
    "seed:pss": "node --import tsx/esm src/seed-pss.ts",
    "refresh": "node --import tsx/esm src/refresh.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
